# Docker 构建上下文排除项
#
# 为什么需要这个文件：.gitignore 只影响 git，**不影响 docker build**。
# 没有它的时候 `COPY . .` 会把 .git 指针、__pycache__、本地数据库、.env
# 全部塞进镜像层——既增大体积，也可能把本地密钥带进公开发布的镜像。

# git 元数据（worktree 下是个指针文件，主仓下是整个 .git 目录）
.git
.gitignore

# 本地密钥与配置（绝不能进镜像）
.env
.env.*
!.env.example

# 本地运行时数据（数据库、订阅文件、监控缓存）
data/*.db
data/*.db-*
data/*.json
data/*.tmp*
data/*.log

# Python 字节码与缓存
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# 虚拟环境
.venv
venv
ENV
env

# 编辑器与系统杂物
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# 日志
*.log
logs/
