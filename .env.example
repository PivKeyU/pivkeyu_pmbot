# Telegram Bot配置
BOT_TOKEN=your_bot_token_here
FORUM_GROUP_ID=-1001234567890

# 管理员ID（逗号分隔）
ADMIN_IDS=123456789,987654321

# Gemini API配置
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=
ENABLE_AI_FILTER=true
AI_CONFIDENCE_THRESHOLD=70

# OpenAI API配置 (可选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 功能开关
VERIFICATION_ENABLED=true
AUTO_UNBLOCK_ENABLED=true

# 数据库配置
DATABASE_PATH=./data/bot.db

# 消息队列配置
MAX_WORKERS=5
QUEUE_TIMEOUT=30

# 验证配置
VERIFICATION_TIMEOUT=300
MAX_VERIFICATION_ATTEMPTS=3

# 速率限制
MAX_MESSAGES_PER_MINUTE=30

# 适用于 Watchtower 的 Telegram 通知（可选。若启用，需删除配置的#注释）
#WATCHTOWER_NOTIFICATIONS=shoutrrr
#WATCHTOWER_NOTIFICATION_URL=telegram://token@telegram?chats=channel-1[,chat-id-1,...]

# 镜像更新（Docker 部署时可选的「检查镜像更新」功能）
# 机器人通过 Watchtower 的 HTTP API 触发拉镜像+重建容器。
# 不配置的话，面板里的「检查镜像更新」仍可用来查看状态，但点「确认更新」会提示没配口令。
#
# 1) 生成一个随机口令（不要用弱口令，这个口令能触发容器重建）：
#      openssl rand -hex 32
# 2) 把同一个值填到下面的 WATCHTOWER_HTTP_API_TOKEN，
#    以及 watchtower/docker-compose.yml 的 WATCHTOWER_HTTP_API_TOKEN。
WATCHTOWER_HTTP_API_URL=http://watchtower:8080
WATCHTOWER_HTTP_API_TOKEN=

# 可选：覆盖要检查的镜像（默认 pivkeyu/pivkeyu_pmbot:latest）
#UPDATE_IMAGE_REPO=pivkeyu/pivkeyu_pmbot
#UPDATE_IMAGE_TAG=latest

# 可选：非容器部署时，若你想让面板显示「镜像更新」而非「Git 更新」，设这个为 1
#RUNNING_IN_DOCKER=
